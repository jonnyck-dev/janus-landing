{
  "rewrites": [
    { "source": "/mistudio", "destination": "/studio.html" },
    { "source": "/adminpanel", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
